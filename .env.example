# ============================================================
#  MAX — environment configuration
#  Copy this file to ".env" and fill in your values.
#     cp .env.example .env
# ============================================================

# Your AgentRouter API key (get it from https://agentrouter.org/console/token)
# Looks like:  sk-xxxxxxxxxxxxxxxxxxxxxxxx
AGENTROUTER_API_KEY=sk-your-key-here

# The upstream base URL. Default is AgentRouter's Anthropic-compatible gateway.
# The server will call `${AGENTROUTER_BASE_URL}/v1/messages`.
AGENTROUTER_BASE_URL=https://agentrouter.org

# Default model used when the UI doesn't specify one.
DEFAULT_MODEL=claude-opus-4-8

# Interface to bind. Keep 127.0.0.1 for local-only access; use 0.0.0.0 in a container.
HOST=127.0.0.1

# ============================================================
#  Authentication (login + super admin + user management)
# ============================================================
# Turn login on/off. When on, a super admin is created on first run.
AUTH_ENABLED=true
# The bootstrap super admin. If SUPERADMIN_PASSWORD is blank, a random one is
# generated and printed in the server console on first run (change it after login).
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=
# How long a login stays valid (hours). Default 7 days.
SESSION_TTL_HOURS=168
# Optional: fix the session-signing secret (else one is generated in ./data).
SESSION_SECRET=

# Port the local server listens on.
PORT=8787

# Allow the browser UI to supply its own API key (overrides the server key).
# Set to "false" if you want to force everyone to use the server-side key only.
ALLOW_CLIENT_KEY=true

# Simple per-IP rate limiting (requests per minute). Set to 0 to disable.
RATE_LIMIT_PER_MIN=60

# Maximum total time for an upstream response, including streaming.
UPSTREAM_TIMEOUT_MS=120000

# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Max size (bytes) of a repo file MAX will load into the chat. Default 512 KB.
MAX_FILE_BYTES=524288

# AgentRouter is a drop-in Claude Code gateway and REQUIRES a Claude-CLI-like
# User-Agent. Leave this default unless your gateway explicitly needs another.
UPSTREAM_USER_AGENT=claude-cli/2.0.0 (external, cli)

# ============================================================
#  GitHub integration (optional)
#  Lets you push conversations to a repo. You can instead enter
#  these in the app's Settings (token is kept in-browser only).
# ============================================================

# A GitHub token with the "repo" scope (classic) or "Contents: write"
# (fine-grained). Leave blank to require users to supply their own in Settings.
GITHUB_TOKEN=

# Default repository target (users can override in Settings).
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Set to "false" to force the server-side token only (ignore browser-supplied tokens).
ALLOW_CLIENT_GITHUB_TOKEN=true

# GitHub API base (change only for GitHub Enterprise).
GITHUB_API_BASE=https://api.github.com

# ============================================================
#  GitLab integration (optional) — same idea as GitHub.
# ============================================================
GITLAB_TOKEN=
ALLOW_CLIENT_GITLAB_TOKEN=true
# Change only for self-hosted GitLab (e.g. https://gitlab.example.com/api/v4).
GITLAB_API_BASE=https://gitlab.com/api/v4

# ============================================================
#  Powers (integrations)
# ============================================================
# Web Search power proxies to a Tavily-compatible API. Users supply their own
# key in the Powers panel; override the base only if needed.
TAVILY_API_BASE=https://api.tavily.com
